# ==============================================
# TaskPlanet Social Media Backend Configuration
# ==============================================

# Server Environment
PORT=5001
NODE_ENV=production

# MongoDB Atlas Database Connection
# Replace with your actual MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/social-app?retryWrites=true&w=majority

# JWT Authentication Secret Key
# Generate a secure 32+ character random string
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Media Storage (CDN for Post Images & Avatars)
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed Frontend Production Origin (CORS Whitelist)
# Example: https://taskplanet-social.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app
